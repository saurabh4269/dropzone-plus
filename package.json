{
  "name": "dropzone-plus",
  "version": "0.1.0",
  "description": "Ring camera checks your yard's drone drop zone before the drone arrives. Advisory, veto-only.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "sim": "node scripts/simulate-events.js",
    "ring:probe": "node scripts/ring-probe.js",
    "e2e": "node scripts/e2e.mjs",
    "test:all": "npm test && npm run test:alexa && npm run e2e && npm run e2e:app",
    "e2e:app": "node scripts/e2e-app.mjs",
    "playground": "node scripts/playground-e2e.mjs",
    "test:alexa": "cd alexa-skill/lambda && ./build.sh >/dev/null && cd .. && node --test test/skill.test.mjs"
  },
  "optionalDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-rekognition": "^3.700.0"
  },
  "devDependencies": {
    "ring-partner-sandbox": "github:saurabh4269/ring-partner-sandbox"
  }
}
